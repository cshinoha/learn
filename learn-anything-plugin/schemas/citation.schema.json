{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotebookLMCitation",
  "description": "One normalized, metadata-only NotebookLM citation stored as one JSONL row. Never store raw NotebookLM blobs, full MCP dumps, credentials, downloaded files, private source text, or long source excerpts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "citation_id",
    "created_at",
    "skill_slug",
    "query_id",
    "used_for",
    "notebook_id",
    "source_id",
    "source_title",
    "source_url",
    "location_type",
    "location",
    "timestamp_seconds",
    "page",
    "section_title",
    "snippet",
    "deep_link",
    "confidence"
  ],
  "properties": {
    "citation_id": {
      "type": "string",
      "pattern": "^cit_[a-f0-9]{12,64}$",
      "description": "Stable citation ID, typically generated from skill/source/location/snippet hash."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "skill_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "used_for": {
      "type": "string",
      "pattern": "^(lesson|question|material|research|assessment):[A-Za-z0-9_.:-]+$"
    },
    "notebook_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Original link-only source URL. Do not use local file paths."
    },
    "location_type": {
      "type": "string",
      "enum": ["timestamp", "page", "section", "slide", "paragraph", "quote", "url", "other"]
    },
    "location": { "type": ["string", "null"], "maxLength": 300 },
    "timestamp_seconds": { "type": ["number", "null"], "minimum": 0 },
    "page": { "type": ["string", "null"], "maxLength": 80 },
    "section_title": { "type": ["string", "null"], "maxLength": 200 },
    "snippet": {
      "type": "string",
      "maxLength": 600,
      "description": "Short excerpt only, selected because it was actually used. No raw answer/source blob."
    },
    "deep_link": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  }
}
