{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotebookLMRetrievalPack",
  "description": "Transient compact evidence pack returned from NotebookLM RAG to the main LLM context. It is not a long-term cache and must not contain raw NotebookLM blobs or full source text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "created_at",
    "skill_slug",
    "query",
    "retrieval_mode",
    "notebook_ids",
    "answer_summary",
    "citations",
    "followup_queries",
    "confidence",
    "limitations"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^rpack_[a-f0-9]{12,64}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "skill_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "retrieval_mode": {
      "type": "string",
      "const": "cross_notebook_query"
    },
    "notebook_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "uniqueItems": true
    },
    "answer_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500,
      "description": "Compact synthesis only. Do not paste a long raw NotebookLM answer."
    },
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/definitions/pack_citation" }
    },
    "followup_queries": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "limitations": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "definitions": {
    "pack_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "notebook_id",
        "source_id",
        "source_title",
        "source_url",
        "location_type",
        "location",
        "timestamp_seconds",
        "page",
        "section_title",
        "snippet",
        "deep_link",
        "confidence"
      ],
      "properties": {
        "citation_id": { "type": "string", "pattern": "^cit_[a-f0-9]{12,64}$" },
        "notebook_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "location_type": { "type": "string", "enum": ["timestamp", "page", "section", "slide", "paragraph", "quote", "url", "other"] },
        "location": { "type": ["string", "null"], "maxLength": 300 },
        "timestamp_seconds": { "type": ["number", "null"], "minimum": 0 },
        "page": { "type": ["string", "null"], "maxLength": 80 },
        "section_title": { "type": ["string", "null"], "maxLength": 200 },
        "snippet": { "type": "string", "maxLength": 600 },
        "deep_link": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    }
  }
}
