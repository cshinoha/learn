{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotebookLMManifest",
  "type": "object",
  "required": ["version", "skill_slug", "skill_id", "created_at", "updated_at", "naming_convention", "binding_strategy", "transport", "notebooks", "sources", "artifacts", "sync"],
  "properties": {
    "version": { "type": "string" },
    "skill_slug": { "type": "string" },
    "skill_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "naming_convention": { "const": "LA - <skill-slug> - <short-id> - <shard>" },
    "binding_strategy": { "const": "names_plus_mirror" },
    "transport": {
      "type": "object",
      "required": ["type", "endpoint_env", "mcp_server", "last_checked_at"],
      "properties": {
        "type": { "const": "mcp" },
        "endpoint_env": { "const": "NOTEBOOKLM_MCP_ENDPOINT" },
        "mcp_server": { "type": ["string", "null"] },
        "last_checked_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "notebooks": { "type": "array", "items": { "type": "object" } },
    "sources": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "sync": {
      "type": "object",
      "required": ["last_sync_at", "last_error"],
      "properties": {
        "last_sync_at": { "type": ["string", "null"], "format": "date-time" },
        "last_error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Metadata only. Never include raw source text, raw NotebookLM answers, secrets, credentials, cookies, bearer tokens, downloaded files, or local caches."
}
